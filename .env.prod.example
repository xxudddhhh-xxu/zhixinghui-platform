# ===== 智星惠生产环境变量模板 =====
# 复制为 .env.prod 后逐项修改;GLM/JPT 密钥必填,否则问答与检索不可用

# ---- 数据库(容器内部互通,一般不用改) ----
DB_USER=postgres
DB_PASSWORD=postgres123
DB_NAME=zhixinghui

# ---- 安全(务必改掉) ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=12h

# ---- 前端访问后端的公开地址 ----
# 浏览器可达,通常为 http://服务器IP:3002/api 或 https://api.你的域名/api(走 Nginx)
NEXT_PUBLIC_API_BASE=http://你的服务器IP:3002/api

# ---- AI 模型(OpenAI 兼容中转,必填) ----
GLM_BASE_URL=https://yun.youanapp.com/v1
GLM_API_KEY=sk-xxxxxxxx
GLM_MODEL_ID=glm-5.3
EMBEDDING_ID=embedding-3

JPT_BASE_URL=https://37chatgpt37.com
JPT_API_KEY=sk-xxxxxxxx
JPT_MODEL_ID=gpt-5.6-sol

# ---- 行为 ----
SEED_ON_BOOT=true

# ---- RAG 切片参数(可选) ----
# CHUNK_SIZE=480
# CHUNK_OVERLAP=80
