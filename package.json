{
  "name": "zhixinghui-platform",
  "version": "1.0.0",
  "private": true,
  "description": "智星惠在线团队文档协作平台 - Next.js + NestJS + Python RAG",
  "scripts": {
    "docker": "docker compose up -d",
    "docker:down": "docker compose down",
    "dev:backend": "pnpm --filter @zhixinghui/backend run start:dev",
    "dev:frontend": "pnpm --filter @zhixinghui/frontend run dev",
    "build:backend": "pnpm --filter @zhixinghui/backend run build",
    "build:frontend": "pnpm --filter @zhixinghui/frontend run build",
    "start:backend": "pnpm --filter @zhixinghui/backend run start:prod",
    "start:frontend": "pnpm --filter @zhixinghui/frontend run start"
  },
  "engines": {
    "node": ">=18.17"
  },
  "packageManager": "pnpm@11.21.0"
}
